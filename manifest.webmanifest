{
  "name": "CoTribu",
  "short_name": "CoTribu",
  "description": "L'organisation de la maison, partagée par toute la famille.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FAF8F4",
  "theme_color": "#789985",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "./",
  "shortcuts": [
    {
      "name": "Ajouter aux courses",
      "short_name": "Courses",
      "url": "./?go=courses",
      "icons": [
        {
          "src": "icons/shortcut-courses.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Nouvelle tâche",
      "short_name": "Tâche",
      "url": "./?go=task",
      "icons": [
        {
          "src": "icons/shortcut-task.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Nouvel événement",
      "short_name": "Événement",
      "url": "./?go=event",
      "icons": [
        {
          "src": "icons/shortcut-event.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Nouveau souvenir",
      "short_name": "Souvenir",
      "url": "./?go=memory",
      "icons": [
        {
          "src": "icons/shortcut-memory.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "photos",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
